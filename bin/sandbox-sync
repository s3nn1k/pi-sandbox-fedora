#!/usr/bin/env bash
set -uo pipefail
SBX="$HOME/pi-sandbox-fedora"

status=0
fail() {
  echo "sandbox-sync: FAIL: $1" >&2
  status=1
}

grep -qF '172.28.0.0/24' "$SBX/compose.yaml" \
  || fail "в $SBX/compose.yaml нет закреплённой подсети 172.28.0.0/24"

if zone_info="$(firewall-cmd --info-zone docker 2>/dev/null)"; then
  grep -qE '^[[:space:]]*target: %%REJECT%%[[:space:]]*$' <<<"$zone_info" \
    || fail "target зоны docker не %%REJECT%% (см. firewall-cmd --info-zone docker) — прогони install.sh"
else
  fail "зоны docker нет — появится после первого старта docker; прогони install.sh"
fi

systemctl --user is-active --quiet herdr-bridge \
  || fail "юнит herdr-bridge не активен — systemctl --user enable --now herdr-bridge"

if docker info >/dev/null 2>&1; then
  docker image inspect pi-agent-base >/dev/null 2>&1 \
    || fail "образа pi-agent-base нет — make -C $SBX image"
else
  echo "sandbox-sync: WARN: docker недоступен — проверка образа pi-agent-base пропущена" >&2
fi

if [ "$status" = 0 ]; then
  echo "sandbox-sync: ok — compose-подсеть 172.28.0.0/24, зона docker REJECT, herdr-bridge активен, образ на месте"
else
  echo "sandbox-sync: FAIL — исправь проверки выше" >&2
fi
exit "$status"
