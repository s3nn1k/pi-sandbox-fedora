#!/usr/bin/python3
import json
import os
import shutil
import socket
import stat
import sys
import threading
import time

SOCK_PATH = os.path.expanduser("~/.config/herdr/herdr.sock")
DEFAULT_LISTEN_PATH = os.path.expanduser("~/tmp/pi-cache/herdr-bridge/herdr.sock")
ALLOWED_METHODS = {"pane.report_agent", "pane.report_agent_session"}
MAX_LINE = 1024 * 1024  # защита от переполнения буфера мусором без \n


def log(msg):
    print("herdr-bridge: %s" % msg, file=sys.stderr, flush=True)


def reject_response(request_id):
    return json.dumps({
        "id": request_id,
        "error": {
            "code": "method_not_allowed",
            "message": "bridge allows only status reports",
        },
    }).encode("utf-8") + b"\n"


def pipe_responses(upstream, client):
    try:
        while True:
            data = upstream.recv(65536)
            if not data:
                break
            client.sendall(data)
    except OSError:
        pass
    finally:
        for sock in (upstream, client):
            try:
                sock.close()
            except OSError:
                pass


ACTIVE = threading.Semaphore(32)


def handle(client):
    if not ACTIVE.acquire(blocking=False):
        log("reject: connection limit")
        try:
            client.close()
        except OSError:
            pass
        return
    try:
        _handle(client)
    finally:
        ACTIVE.release()


def _handle(client):
    client.settimeout(300)
    try:
        upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        upstream.settimeout(300)
        upstream.connect(SOCK_PATH)
    except OSError as exc:
        log("upstream unavailable: %s" % exc)
        try:
            client.sendall(json.dumps(
                {"id": None, "error": {"code": "bridge_unavailable"}}
            ).encode("utf-8") + b"\n")
        except OSError:
            pass
        client.close()
        return

    threading.Thread(
        target=pipe_responses, args=(upstream, client), daemon=True
    ).start()

    buf = b""
    while True:
        try:
            chunk = client.recv(65536)
        except OSError:
            break
        if not chunk:
            break
        if len(buf) + len(chunk) > MAX_LINE:
            log("reject: line without newline exceeds MAX_LINE")
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            line = line.strip()
            if not line:
                continue

            request_id = None
            request = None
            try:
                if len(line) > MAX_LINE:
                    raise ValueError("line too long")
                request = json.loads(line.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                request = None
            if not isinstance(request, dict):
                method = None
            else:
                method = request.get("method")
                request_id = request.get("id")

            if method in ALLOWED_METHODS:
                try:
                    payload = {"method": method, "id": request_id}
                    if "params" in request:
                        payload["params"] = request["params"]
                    upstream.sendall(json.dumps(payload).encode("utf-8") + b"\n")
                except OSError:
                    return
            else:
                log("reject: %s" % line[:100].decode("utf-8", "replace"))
                try:
                    client.sendall(reject_response(request_id))
                except OSError:
                    pass
                for sock in (upstream, client):
                    try:
                        sock.close()
                    except OSError:
                        pass
                return

    for sock in (upstream, client):
        try:
            sock.close()
        except OSError:
            pass


def bind_listen(listen_path):
    listen_dir = os.path.dirname(listen_path)
    if listen_dir:
        os.makedirs(listen_dir, exist_ok=True)
    try:
        os.unlink(listen_path)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(listen_path)
    os.chmod(listen_path, 0o600)
    server.listen(16)
    server.settimeout(5)
    return server


def self_heal(holder, listen_path):
    while True:
        time.sleep(5)
        try:
            try:
                sock_ok = stat.S_ISSOCK(os.lstat(listen_path).st_mode)
            except FileNotFoundError:
                sock_ok = False
            if sock_ok:
                continue
            if os.path.islink(listen_path):
                os.unlink(listen_path)
                log("removed symlink at %s" % listen_path)
            elif os.path.isdir(listen_path):
                shutil.rmtree(listen_path)
                log("removed directory at %s" % listen_path)
            elif os.path.lexists(listen_path):
                os.unlink(listen_path)
                log("removed file at %s" % listen_path)
            try:
                holder[0].close()
            except OSError:
                pass
            holder[0] = bind_listen(listen_path)
            log("rebound after replacement")
        except Exception as exc:
            log("heal cycle failed: %s" % exc)


def main():
    listen_path = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_LISTEN_PATH
    holder = [bind_listen(listen_path)]
    log("listening on %s -> %s (allow: %s)"
        % (listen_path, SOCK_PATH, ", ".join(sorted(ALLOWED_METHODS))))

    threading.Thread(target=self_heal, args=(holder, listen_path), daemon=True).start()
    wait_start = time.time()
    waited_notice = 0
    while not os.path.exists(SOCK_PATH):
        time.sleep(5)
        waited = int((time.time() - wait_start) / 60)
        if waited >= (waited_notice + 10):
            waited_notice = waited
            log("waiting for %s (%d min)" % (SOCK_PATH, waited))

    while True:
        try:
            client, _ = holder[0].accept()
        except socket.timeout:
            continue
        except OSError:
            time.sleep(1)
            continue
        threading.Thread(target=handle, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
